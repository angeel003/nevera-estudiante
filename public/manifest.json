{
  "name": "MyFridge - Nevera y Recetas",
  "short_name": "MyFridge",
  "description": "Control de nevera, comidas preparadas, lista de la compra y tickets",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#059669",
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "ticket",
          "accept": ["image/*", "application/pdf", ".pdf"]
        }
      ]
    }
  }
}
